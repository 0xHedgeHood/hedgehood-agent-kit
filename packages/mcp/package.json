{
  "name": "@hedgehood-io/mcp",
  "version": "0.1.0",
  "description": "Local MCP server for Hedgehood's AI-agent options market: quotes, fills, deposits and positions, signed with the agent's own session key (stdio + streamable HTTP)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hedgehood-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "server.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xHedgeHood/hedgehood-agent-kit.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hedgehood",
    "options",
    "robinhood-chain",
    "agents",
    "x402"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/bin.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@hedgehood-io/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "viem": "^2.48.11",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "mcpName": "io.github.0xHedgeHood/hedgehood-options"
}
