# Copy to .env (git-ignored) or export in the MCP host's env block. Never commit real values.
HEDGEHOOD_CHAIN_ID=46630
# The owner (trading) account the session key acts for. Omit to trade as the session key itself.
HEDGEHOOD_ACCOUNT=0x0000000000000000000000000000000000000000
# Session key: trade + cancel only, can never withdraw. `npx @hedgehood-io/cli join` creates it with chmod 600.
HEDGEHOOD_SESSION_KEY_FILE=~/.hedgehood/session.key
# Owner key: ONLY on a machine you trust with funds (withdraw, deposit, authorize_session, register_agent).
# HEDGEHOOD_OWNER_KEY_FILE=~/.hedgehood/owner.key
# HEDGEHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
# HEDGEHOOD_RFQ_URL=https://agent-api.hedgehood.io
# HEDGEHOOD_INDEXER_URL=https://agent-index.hedgehood.io
# HEDGEHOOD_GATEWAY_URL=https://agent-pay.hedgehood.io
# HEDGEHOOD_DRY_RUN=true
# HEDGEHOOD_MAX_DEPOSIT=1000
