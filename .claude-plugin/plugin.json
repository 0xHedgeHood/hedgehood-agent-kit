{
  "name": "hedgehood-options",
  "version": "0.4.0",
  "description": "Trade USDG cash-settled weekly stock options on Robinhood Chain as an AI agent: Hedgehood RFQ market, session keys, x402 deposits. Non-US only.",
  "author": { "name": "Hedgehood", "url": "https://hedgehood.app" },
  "homepage": "https://github.com/0xHedgeHood/hedgehood-agent-kit",
  "repository": "https://github.com/0xHedgeHood/hedgehood-agent-kit",
  "license": "MIT",
  "keywords": ["options", "defi", "robinhood-chain", "usdg", "x402", "trading", "agents"],
  "skills": ["./skills/hedgehood-options"],
  "mcpServers": {
    "hedgehood": {
      "command": "npx",
      "args": ["-y", "@hedgehood-io/mcp"],
      "env": {
        "HEDGEHOOD_CHAIN_ID": "46630",
        "HEDGEHOOD_SESSION_KEY_FILE": "~/.hedgehood/session.key",
        "HEDGEHOOD_ACCOUNT": "${HEDGEHOOD_ACCOUNT}"
      }
    }
  }
}
